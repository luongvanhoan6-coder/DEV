# Sao chép tệp này thành .env rồi điền giá trị. KHÔNG commit tệp .env.
# Tất cả đều TÙY CHỌN – hệ thống vẫn chạy khi để trống.

# --- Claude API (tùy chọn, TÍNH PHÍ) – dùng khi content.provider: anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Cloud Text-to-Speech (tùy chọn, có hạn mức miễn phí) – voice.provider: google_cloud ---
GOOGLE_TTS_API_KEY=

# --- Gemini API – giọng đọc (tùy chọn, có hạn mức miễn phí) – voice.provider: gemini ---
# Lấy khóa tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google Sheets (tùy chọn): đường dẫn CSV công khai của trang tính kho câu nói ---
GSHEET_CSV_URL=

# --- Đường dẫn ffmpeg/ffprobe nếu không có trong PATH (Windows) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe
